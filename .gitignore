# dependencies
/node_modules
.pnpm-store/

# Next.js build output (`out/` is the static export)
/.next/
/out/

# TypeScript (next-env.d.ts is regenerated by `next dev` / `next build`)
*.tsbuildinfo
next-env.d.ts

# env files (never commit keys)
.env*

# test recordings / projects (large binaries)
*.vidz
*.webm
*.mp4

# debug logs & OS junk
*.log
*.pem
.DS_Store
.vercel
/coverage

# Playwright
/test-results/
/playwright-report/
/blob-report/
